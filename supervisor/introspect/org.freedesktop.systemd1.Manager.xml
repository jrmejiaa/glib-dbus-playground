<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.freedesktop.systemd1.Manager">
    <method name="GetUnit">
      <arg type="s" name="name" direction="in" />
      <arg type="o" name="unit" direction="out" />
    </method>
    <method name="StartUnit">
      <arg type="s" name="name" direction="in" />
      <arg type="s" name="mode" direction="in" />
      <arg type="o" name="job" direction="out" />
    </method>
    <method name="StopUnit">
      <arg type="s" name="name" direction="in" />
      <arg type="s" name="mode" direction="in" />
      <arg type="o" name="job" direction="out" />
    </method>
    <method name="RestartUnit">
      <arg type="s" name="name" direction="in" />
      <arg type="s" name="mode" direction="in" />
      <arg type="o" name="job" direction="out" />
    </method>
    <method name="KillUnit">
      <arg type="s" name="name" direction="in" />
      <arg type="s" name="whom" direction="in" />
      <arg type="i" name="signal" direction="in" />
    </method>
    <method name="Subscribe">
    </method>
    <signal name="UnitNew">
      <arg type="s" name="id" />
      <arg type="o" name="unit" />
    </signal>
    <signal name="UnitRemoved">
      <arg type="s" name="id" />
      <arg type="o" name="unit" />
    </signal>
    <signal name="JobRemoved">
      <arg type="u" name="id" />
      <arg type="o" name="job" />
      <arg type="s" name="unit" />
      <arg type="s" name="result" />
    </signal>
  </interface>
  <node name="unit" />
  <node name="job" />
</node>