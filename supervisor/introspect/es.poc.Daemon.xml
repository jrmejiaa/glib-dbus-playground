<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "https://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <!--
        The dummy daemon's own interface. A single read-only State property that
        carries application-level readiness the Supervisor cannot see from systemd.

        State is a uint32 enum:
            0 = initializing   (process up, not yet ready)
            1 = ready          (initialized and operating)
            2 = degraded       (clear application error; set just before exit(N))

        EmitsChangedSignal=true: the daemon's PropertiesChanged carries the new
        value, so the Supervisor reacts to transitions without polling.
    -->
    <interface name="es.poc.Daemon">
        <property name="State" type="u" access="read">
            <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true" />
        </property>
    </interface>
</node>
